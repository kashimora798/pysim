# Example for local development only — never commit a real .env with a key.
# FieldForge is a static site; Vite inlines every VITE_* variable, so a real
# key must NOT be placed in VITE_*. See web/src/ff/ai-config.ts.

# Local proxy that injects the key server-side (if you have one):
# VITE_FF_AI_PROXY=http://localhost:8787/api/extract

# Optional CDN base override (defaults to jsDelivr example-assets):
# VITE_IWSDK_EXAMPLE_ASSET_BASE_URL=https://cdn.jsdelivr.net/npm/@iwsdk/example-assets@0.4.2/assets

# Never add:
# VITE_OPENAI_API_KEY=...
# VITE_FF_API_KEY=...
